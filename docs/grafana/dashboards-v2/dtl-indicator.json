{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Generic drill-down for any sfdx-hardis indicator: pick the org, the notification type and the exact metric to see its value, its evolution and the detailed rows.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [
    {
      "asDropdown": true,
      "icon": "external link",
      "includeVars": true,
      "keepTime": false,
      "tags": [
        "sfdx-hardis-v2"
      ],
      "targetBlank": false,
      "title": "Org Monitoring by sfdx-hardis",
      "type": "dashboards"
    }
  ],
  "panels": [
    {
      "id": 152,
      "type": "row",
      "title": "$metric ($type) on $org",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 148,
      "type": "stat",
      "title": "Latest value",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "gridPos": {
        "h": 7,
        "w": 5,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "expr": "max by (orgIdentifier) (last_over_time(${metric}{source=\"sfdx-hardis\", orgIdentifier=\"$org\"}[8d]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "id": 149,
      "type": "timeseries",
      "title": "Evolution",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "gridPos": {
        "h": 7,
        "w": 14,
        "x": 5,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "expr": "max by (orgIdentifier) (last_over_time(${metric}{source=\"sfdx-hardis\", orgIdentifier=\"$org\"}[1d]))",
          "refId": "A",
          "legendFormat": "$metric"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue"
              }
            ]
          },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "drawStyle": "line",
            "fillOpacity": 12,
            "gradientMode": "opacity",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": true,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 150,
      "type": "stat",
      "title": "Stats generation date",
      "datasource": {
        "type": "loki",
        "uid": "${ds_loki}"
      },
      "gridPos": {
        "h": 7,
        "w": 5,
        "x": 19,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${ds_loki}"
          },
          "expr": "{source=\"sfdx-hardis\", type=\"$type\", orgIdentifier=\"$org\"} |= ``",
          "queryType": "range",
          "direction": "backward",
          "refId": "A",
          "maxLines": 1
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "format": "json",
            "jsonPaths": [
              {
                "path": "_dateTime"
              },
              {
                "path": "_jobUrl"
              }
            ],
            "keepTime": false,
            "replace": true,
            "source": "Line"
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "destinationType": "time",
                "targetField": "_dateTime"
              }
            ],
            "fields": {}
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^_dateTime$/",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "id": 151,
      "type": "table",
      "title": "Detailed elements (latest run)",
      "datasource": {
        "type": "loki",
        "uid": "${ds_loki}"
      },
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${ds_loki}"
          },
          "expr": "{source=\"sfdx-hardis\", type=\"$type\", orgIdentifier=\"$org\"} |= ``",
          "queryType": "range",
          "direction": "backward",
          "refId": "A",
          "maxLines": 1
        }
      ],
      "description": "Rows of the latest run found within the selected time range. Detail rows come from logs (Loki), which usually keep ~30 days: if the graph shows history but this table is empty, the last run is older than the logs retention. Check the org monitoring job.",
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "format": "json",
            "jsonPaths": [
              {
                "path": "_logElements"
              }
            ],
            "keepTime": false,
            "replace": true,
            "source": "Line"
          }
        },
        {
          "id": "extractFields",
          "options": {
            "format": "auto",
            "replace": true,
            "source": "_logElements"
          }
        },
        {
          "id": "reduce",
          "options": {
            "includeTimeField": false,
            "labelsToFields": false,
            "mode": "seriesToRows",
            "reducers": [
              "allValues"
            ]
          }
        },
        {
          "id": "extractFields",
          "options": {
            "format": "auto",
            "replace": true,
            "source": "All values"
          }
        },
        {
          "id": "extractFields",
          "options": {
            "replace": true,
            "source": "0"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue"
              }
            ]
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true,
            "inspect": true
          }
        },
        "overrides": []
      },
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true
      }
    }
  ],
  "preload": false,
  "refresh": "",
  "schemaVersion": 42,
  "tags": [
    "sfdx-hardis-v2",
    "sfdx-hardis"
  ],
  "templating": {
    "list": [
      {
        "name": "ds_prom",
        "label": "Prometheus datasource",
        "description": "The Prometheus/Mimir datasource receiving sfdx-hardis metrics (NOTIF_API_METRICS_URL)",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 2,
        "includeAll": false,
        "multi": false,
        "options": [],
        "refresh": 1,
        "regex": "/^(?!.*(alert-state-history|usage-insights|ml-metrics)).*/",
        "skipUrlSync": false
      },
      {
        "name": "ds_loki",
        "label": "Loki datasource",
        "description": "The Loki datasource receiving sfdx-hardis logs (NOTIF_API_URL)",
        "type": "datasource",
        "query": "loki",
        "current": {},
        "hide": 2,
        "includeAll": false,
        "multi": false,
        "options": [],
        "refresh": 1,
        "regex": "/^(?!.*(alert-state-history|usage-insights|ml-metrics)).*/",
        "skipUrlSync": false
      },
      {
        "name": "org",
        "label": "Salesforce Org",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${ds_prom}"
        },
        "definition": "label_values({source=\"sfdx-hardis\"}, orgIdentifier)",
        "query": {
          "qryType": 1,
          "query": "label_values({source=\"sfdx-hardis\"}, orgIdentifier)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "current": {},
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "options": [],
        "refresh": 2,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1
      },
      {
        "name": "type",
        "label": "Indicator",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "${ds_loki}"
        },
        "query": {
          "label": "type",
          "refId": "LokiVariableQueryEditor-VariableQuery",
          "stream": "{source=\"sfdx-hardis\", orgIdentifier=\"$org\"}",
          "type": 1
        },
        "current": {},
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "options": [],
        "refresh": 2,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1
      },
      {
        "name": "metric",
        "label": "Metric",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${ds_prom}"
        },
        "definition": "label_values({source=\"sfdx-hardis\", type=\"$type\", orgIdentifier=\"$org\"}, __name__)",
        "query": {
          "qryType": 1,
          "query": "label_values({source=\"sfdx-hardis\", type=\"$type\", orgIdentifier=\"$org\"}, __name__)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "current": {},
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "options": [],
        "refresh": 2,
        "regex": "/^(?!.*_max$).*/",
        "skipUrlSync": false,
        "sort": 1
      }
    ]
  },
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "",
  "title": "80 - Indicator Detail",
  "uid": "sfdx-hardis-v2-dtl-indicator",
  "version": 1,
  "weekStart": ""
}
