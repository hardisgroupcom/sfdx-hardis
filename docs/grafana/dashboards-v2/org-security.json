    {
      "id": 106,
      "type": "stat",
      "title": "Stats generation date",
      "datasource": {
        "type": "loki",
        "uid": "${ds_loki}"
      },
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${ds_loki}"
          },
          "expr": "{source=\"sfdx-hardis\", type=\"ORG_HEALTH_CHECK\", orgIdentifier=\"$org\"} |= ``",
          "queryType": "range",
          "direction": "backward",
          "refId": "A",
          "maxLines": 1
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "format": "json",
            "jsonPaths": [
              {
                "path": "_dateTime"
              },
              {
                "path": "_jobUrl"
              }
            ],
            "keepTime": false,
            "replace": true,
            "source": "Line"
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "destinationType": "time",
                "targetField": "_dateTime"
              }
            ],
            "fields": {}
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^_dateTime$/",
          "values": false
        },
        "textMode": "auto"
      }
    },
