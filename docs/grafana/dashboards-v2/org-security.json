          },
          "expr": "max by (orgIdentifier) (last_over_time(Score_metric{source=\"sfdx-hardis\", orgIdentifier=\"$org\"}[1d]))",
          "refId": "A",
          "legendFormat": "Score"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
