{
  "command": "hardis:org:ext-client-app:rotate-credentials",
  "exitCode": 0,
  "events": [
    {
      "delay": 0,
      "message": {
        "event": "initClient"
      }
    },
    {
      "delay": 300,
      "message": {
        "event": "commandLogLine",
        "logType": "action",
        "message": "Listing External Client Apps available in the org..."
      }
    },
    {
      "delay": 900,
      "message": {
        "event": "commandLogLine",
        "logType": "action",
        "message": "🦙 Select the External Client App whose credentials you want to rotate",
        "isQuestion": true
      }
    },
    {
      "delay": 50,
      "message": {
        "event": "prompts",
        "prompts": [
          {
            "type": "select",
            "name": "value",
            "message": "🦙 Select the External Client App whose credentials you want to rotate",
            "description": "Select the External Client App whose credentials you want to rotate",
            "choices": [
              {
                "title": "Helios CI/CD (sfdx-hardis)",
                "value": "sfdxhardis_helios_cicd"
              },
              {
                "title": "Helios Installer Mobile Sync",
                "value": "helios_installer_sync"
              },
              {
                "title": "Helios Monitoring (sfdx-hardis)",
                "value": "sfdxhardismon_helios_solar"
              }
            ],
            "optionsPerPage": 9999,
            "initial": 0
          }
        ]
      }
    },
    {
      "delay": 100,
      "message": {
        "event": "commandLogLine",
        "logType": "log",
        "message": "Helios Monitoring (sfdx-hardis)"
      }
    },
    {
      "delay": 400,
      "message": {
        "event": "commandLogLine",
        "logType": "action",
        "message": "Rotating credentials for External Client App sfdxhardismon_helios_solar..."
      }
    },
    {
      "delay": 500,
      "message": {
        "event": "commandLogLine",
        "logType": "action",
        "message": "Staging new credentials for sfdxhardismon_helios_solar..."
      }
    },
    {
      "delay": 900,
      "message": {
        "event": "commandLogLine",
        "logType": "action",
        "message": "Promoting staged credentials to active for sfdxhardismon_helios_solar..."
      }
    },
    {
      "delay": 900,
      "message": {
        "event": "commandLogLine",
        "logType": "success",
        "message": "Credentials rotated successfully for External Client App sfdxhardismon_helios_solar"
      }
    },
    {
      "delay": 300,
      "message": {
        "event": "commandLogLine",
        "logType": "action",
        "message": "New credentials for sfdxhardismon_helios_solar. Copy them now, they are hidden from log files:"
      }
    },
    {
      "delay": 150,
      "message": {
        "event": "commandLogLine",
        "logType": "log",
        "message": "- Consumer Key: <copy>3MVG9HeliosRotatedKey0aB1cD2eF3gH4iJ5kL6mN7oP8qR9sT0uV1wX2yZ3aB4cD5eF6gH7iJ8kL9mN0oP1qR2sT3uV4wX5yZ6aB7cD8eF9gH0</copy>"
      }
    },
    {
      "delay": 100,
      "message": {
        "event": "commandLogLine",
        "logType": "log",
        "message": "- Consumer Secret: <copy>A41F7C0D52B9E8366A1D0C47F93B5E2D8C6A4F10E7B3952D6C8A0F1E4B7D93C5</copy>"
      }
    },
    {
      "delay": 150,
      "message": {
        "event": "commandLogLine",
        "logType": "warning",
        "message": "Update your CI/CD variables (e.g. SFDX_CLIENT_ID) and any integration using this app."
      }
    },
    {
      "delay": 400,
      "message": {
        "event": "commandLogLine",
        "logType": "action",
        "message": "🦙 Do you want to revoke the previous credentials immediately for sfdxhardismon_helios_solar?",
        "isQuestion": true
      }
    },
    {
      "delay": 50,
      "message": {
        "event": "prompts",
        "prompts": [
          {
            "type": "select",
            "name": "value",
            "message": "🦙 Do you want to revoke the previous credentials immediately for sfdxhardismon_helios_solar?",
            "description": "Revoking now breaks every integration still using the previous credentials. Otherwise they stay valid for 30 days.",
            "choices": [
              {
                "title": "✅ Yes",
                "value": true
              },
              {
                "title": "❌ No",
                "value": false
              }
            ],
            "optionsPerPage": 9999,
            "initial": 1
          }
        ]
      }
    },
    {
      "delay": 100,
      "message": {
        "event": "commandLogLine",
        "logType": "log",
        "message": "❌ No"
      }
    },
    {
      "delay": 300,
      "message": {
        "event": "commandLogLine",
        "logType": "warning",
        "message": "The previous credentials stay valid for 30 days unless you revoke them now."
      }
    },
    {
      "delay": 200,
      "message": {
        "event": "commandLogLine",
        "logType": "warning",
        "message": "For security, disable 'Allow access to External Client App consumer secrets via REST API' in External Client App Settings now that rotation is done. Leaving it enabled lets anyone with API access read your consumer secrets."
      }
    },
    {
      "delay": 100,
      "message": {
        "event": "commandLogLine",
        "logType": "warning",
        "message": "Open External Client App Settings: https://helios-solar.my.salesforce-setup.com/lightning/setup/ExternalClientApplicationSettings/home"
      }
    },
    {
      "delay": 150,
      "message": {
        "event": "reportFile",
        "file": "https://helios-solar.my.salesforce-setup.com/lightning/setup/ExternalClientApplicationSettings/home",
        "title": "Open External Client App Settings",
        "type": "actionUrl"
      }
    },
    {
      "delay": 200,
      "message": {
        "event": "closeClient",
        "status": "success"
      }
    }
  ]
}
