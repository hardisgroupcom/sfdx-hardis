      }
    },
    {
      "delay": 600,
      "message": {
        "event": "commandLogLine",
        "logType": "error",
        "message": "Panel_Batch__c.Panel_Type__c: Missing matching value for MONO-410 in [\"MONO-375\",\"MONO-400\",\"POLY-330\"]"
      }
    },
    {
      "delay": 900,
      "message": {
        "event": "commandLogLine",
        "logType": "log",
        "message": "Stats: \n{\n  \"sectionLinesNb\": 3,\n  \"dataLinesNb\": 386,\n  \"emptyLinesNb\": 3,\n  \"totalLinesNb\": 392,\n  \"dataSuccessLinesNb\": 381,\n  \"dataErrorLinesNb\": 5,\n  \"dataFilteredLinesNb\": 0,\n  \"dataDuplicatesNb\": 0,\n  \"sections\": {\n    \"CLIENTS\": {\n      \"dataLinesNb\": 48,\n      \"dataSuccessLinesNb\": 48,\n      \"dataErrorLinesNb\": 0,\n      \"dataFilteredLinesNb\": 0,\n      \"dataFilterErrorsNb\": 0,\n      \"dataDuplicatesNb\": null\n    },\n    \"INSTALLATIONS\": {\n      \"dataLinesNb\": 126,\n      \"dataSuccessLinesNb\": 123,\n      \"dataErrorLinesNb\": 3,\n      \"dataFilteredLinesNb\": 0,\n      \"dataFilterErrorsNb\": 0,\n      \"dataDuplicatesNb\": null\n    },\n    \"PANELS\": {\n      \"dataLinesNb\": 212,\n      \"dataSuccessLinesNb\": 210,\n      \"dataErrorLinesNb\": 2,\n      \"dataFilteredLinesNb\": 0,\n      \"dataFilterErrorsNb\": 0,\n      \"dataDuplicatesNb\": null\n    }\n  }\n}"
      }
    },
    {
      "delay": 100,
      "message": {
        "event": "commandLogLine",
        "logType": "warning",
        "message": "There have been parsing errors:"
      }
    },
    {
      "delay": 50,
      "message": {
        "event": "commandLogLine",
        "logType": "warning",
        "message": "- 3 lines: Installation__c.Install_Date__c: Missing required value"
