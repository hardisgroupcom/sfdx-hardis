    },
    {
      "delay": 50,
      "message": {
        "event": "commandLogLine",
        "logType": "warning",
        "message": "- 2 lines: Panel_Batch__c.Panel_Type__c: Missing matching value for MONO-410 in [\"MONO-375\",\"MONO-400\",\"POLY-330\"]"
      }
    },
    {
      "delay": 50,
      "message": {
        "event": "commandLogLine",
        "logType": "log",
        "message": "[CLIENTS] kept 48 entries on 48"
      }
    },
    {
      "delay": 50,
      "message": {
        "event": "commandLogLine",
        "logType": "log",
        "message": "[INSTALLATIONS] kept 123 entries on 126"
      }
    },
    {
      "delay": 50,
      "message": {
        "event": "commandLogLine",
        "logType": "log",
        "message": "[PANELS] kept 210 entries on 212"
      }
    },
    {
      "delay": 50,
      "message": {
        "event": "commandLogLine",
        "logType": "log",
        "message": "[TOTAL] kept 381 entries on 386 total"
      }
    },
    {
      "delay": 150,
      "message": {
        "event": "commandLogLine",
        "logType": "action",
        "message": "TOML file successfully split into CSV files"
      }
    },
    {
      "delay": 200,
      "message": {
        "event": "closeClient",
        "status": "success"
      }
    }
  ]
