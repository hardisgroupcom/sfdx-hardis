        "message": "Generating CSV files from data/helios-legacy-export.txt (encoding utf8) into folder data/csv."
      }
    },
    {
      "delay": 300,
      "message": {
        "event": "commandLogLine",
        "logType": "action",
        "message": "- Initialized output CSV file: data/csv/Account___CLIENTS.csv"
      }
    },
    {
      "delay": 50,
      "message": {
        "event": "commandLogLine",
        "logType": "action",
        "message": "- Initialized CSV file: data/csv/errors/err__Account___CLIENTS.csv"
      }
    },
    {
      "delay": 300,
      "message": {
        "event": "commandLogLine",
        "logType": "action",
        "message": "- Initialized output CSV file: data/csv/Installation__c___INSTALLATIONS.csv"
      }
    },
    {
      "delay": 50,
      "message": {
        "event": "commandLogLine",
        "logType": "action",
        "message": "- Initialized CSV file: data/csv/errors/err__Installation__c___INSTALLATIONS.csv"
      }
    },
    {
      "delay": 600,
      "message": {
        "event": "commandLogLine",
