    {
      "delay": 100,
      "message": {
        "event": "commandSubCommandStart",
        "data": {
          "command": "git reset --soft HEAD~3",
          "cwd": "."
        }
      }
    },
    {
      "delay": 600,
      "message": {
        "event": "commandSubCommandEnd",
        "data": {
          "command": "git reset --soft HEAD~3",
          "success": true
        }
      }
    },
    {
      "delay": 100,
      "message": {
        "event": "commandSubCommandStart",
        "data": {
          "command": "git reset",
          "cwd": "."
        }
      }
    },
    {
      "delay": 500,
      "message": {
        "event": "commandSubCommandEnd",
        "data": {
          "command": "git reset",
          "success": true
        }
      }
    },
    {
      "delay": 100,
      "message": {
        "event": "commandSubCommandStart",
        "data": {
          "command": "git checkout -- manifest/package.xml",
          "cwd": "."
        }
      }
    },
    {
      "delay": 400,
      "message": {
        "event": "commandSubCommandEnd",
        "data": {
          "command": "git checkout -- manifest/package.xml",
          "success": true
        }
      }
    },
    {
      "delay": 100,
      "message": {
        "event": "commandSubCommandStart",
        "data": {
          "command": "git checkout -- manifest/destructiveChanges.xml",
          "cwd": "."
        }
      }
    },
    {
      "delay": 400,
      "message": {
        "event": "commandSubCommandEnd",
        "data": {
          "command": "git checkout -- manifest/destructiveChanges.xml",
          "success": true
