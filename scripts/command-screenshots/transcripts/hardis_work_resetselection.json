            "message": "🦙 This command will git reset (soft) your branch features/HEL-42-installation-checklist. You will need to select and commit again your files. Are you sure ?",
            "description": "Confirm that you want to perform a soft git reset on your current branch",
            "choices": [
              {
                "title": "✅ Yes",
                "value": true
              },
              {
                "title": "❌ No",
                "value": false
              }
            ],
            "initial": 0
          }
        ]
      }
    },
    {
      "delay": 150,
      "message": {
        "event": "commandLogLine",
        "logType": "log",
        "message": "✅ Yes"
