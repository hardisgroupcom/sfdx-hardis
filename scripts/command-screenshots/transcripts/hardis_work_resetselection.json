{
  "command": "hardis:work:resetselection",
  "exitCode": 0,
  "events": [
    {
      "delay": 0,
      "message": {
        "event": "initClient"
      }
    },
    {
      "delay": 400,
      "message": {
        "event": "commandLogLine",
        "logType": "action",
        "message": "Automatically selected target branch is integration"
      }
    },
    {
      "delay": 300,
      "message": {
        "event": "commandLogLine",
        "logType": "action",
        "message": "This script will rebuild selection that you will want to merge into integration"
      }
    },
    {
      "delay": 350,
      "message": {
        "event": "commandLogLine",
        "logType": "action",
        "message": "🦙 This command will git reset (soft) your branch features/HEL-42-installation-checklist. You will need to select and commit again your files. Are you sure ?",
        "isQuestion": true
      }
    },
    {
      "delay": 60,
      "message": {
        "event": "prompts",
        "prompts": [
          {
            "name": "value",
