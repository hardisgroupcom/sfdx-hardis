# Settings of the promotion-branches-e2e skill. Names only: copy this file to .env at the root of the
# sfdx-hardis working copy (git-ignored) and fill the values, or copy the .env of the computer that
# already runs the test. Every script reads a variable from the environment first, then from .env
# (scripts/env-lib.sh), so nothing has to be exported by hand. E2E_ENV_FILE points to another file.
#
# What .env cannot carry, to do once per computer:
#   gh auth login
#   glab auth login --hostname <GITLAB_E2E_HOST>
#   sf org login web --alias <E2E_ORG>          (and the Dev Hub / developer org when used)
#   git clone https://github.com/hardisgroupcom/vscode-sfdx-hardis.git ../vscode-sfdx-hardis
#   (cd ../vscode-sfdx-hardis && yarn install && yarn compile)
# Then: bash .claude/skills/promotion-branches-e2e/scripts/preflight.sh

# ---------------------------------------------------------------- Salesforce
# REQUIRED. Username or alias of the org the four major branches deploy to (ORG defaults to it).
# Get it: sf org list. A Developer Edition org is fine.
E2E_ORG=
# Optional. Dev Hub that creates the backpromote scratch orgs (runbook 6bis). Default: E2E_ORG.
DEVHUB=
# Optional. Aliases of the two backpromote scratch orgs, created by backpromote-setup.sh when they
# do not exist. Defaults: promo-e2e-dev and promo-e2e-dev2.
DEVORG=
DEVORG2=
# Optional. Username of a scratch org or developer sandbox for the developer org steps of sections
# 6quater (group D) and 6sexies (I7, I8). Not set: those steps are recorded as SKIP.
DEV_ORG=
# Optional. API version of the test project. Default: 67.0.
API=

# ---------------------------------------------------------------- what is tested (real CI, 6quinquies)
# Optional. Branch of hardisgroupcom/sfdx-hardis the CI jobs clone, build and link. It must be
# pushed. Default: the current branch of the working copy. "-" with SFDX_HARDIS_IMAGE: no link step.
SFDX_HARDIS_BRANCH=
# Optional. Docker image of the CI jobs instead of :latest, e.g. ghcr.io/hardisgroupcom/sfdx-hardis-ubuntu:beta
SFDX_HARDIS_IMAGE=
# Optional. With SFDX_HARDIS_BRANCH=-: the version the jobs must print (npm view sfdx-hardis@beta version).
SFDX_HARDIS_VERSION=

# ---------------------------------------------------------------- GitHub
# No token here: the scripts use the login of the GitHub CLI (gh auth login, an account that can
# create private repositories; gh auth refresh -h github.com -s delete_repo to clean up).
# Optional. Owner of the repositories the real CI section creates. Default: the gh login.
GH_E2E_OWNER=

# ---------------------------------------------------------------- GitLab
# REQUIRED for GitLab real CI. Host of the instance, with or without https://.
GITLAB_E2E_HOST=
# REQUIRED for GitLab real CI. Full path of a group whose runners take the jobs (a personal
# namespace has no runner). You need Maintainer or Owner there.
GITLAB_E2E_GROUP=
# No token here either: the scripts read glab config get token --host <host>
# (glab auth login --hostname <host>, a token with the api scope). GL_TOKEN in the environment overrides it.
# Optional. Tag the runners of the group need on a job. Default: ubuntu.
GITLAB_RUNNER_TAG=
# Optional. project (default): the jobs use a project access token created by the run. user: your own token.
GITLAB_E2E_CI_TOKEN=

# ---------------------------------------------------------------- Azure DevOps
# REQUIRED for Azure. Organization name: https://dev.azure.com/<AZ_ORG>/
AZ_ORG=
# REQUIRED for Azure. Team project the test repositories are created in.
AZ_PROJECT=
# REQUIRED for Azure. Personal access token: https://dev.azure.com/<AZ_ORG>/_usersSettings/tokens
# Scopes: Code (Read, write & manage), Pull Request Threads (Read & write); for real CI also
# Build (Read & execute); Security (Manage) lets the run grant the build service its permission.
AZURE_PERSONAL_ACCESS_TOKEN=
# Optional. system (default): the jobs comment with $(System.AccessToken). pat: with the PAT.
AZURE_E2E_CI_TOKEN=

# ---------------------------------------------------------------- Bitbucket Cloud
# REQUIRED for Bitbucket. Workspace slug.
BB_WORKSPACE=
# REQUIRED for Bitbucket real CI and to create a repository. Key of a project of that workspace.
BB_PROJECT_KEY=
# REQUIRED for Bitbucket. Atlassian API token WITH Bitbucket scopes (repository read, write and
# admin, pull request read and write, pipeline read and write, pipeline variables), and its account
# email: https://id.atlassian.com/manage-profile/security/api-tokens
ATLASSIAN_TOKEN=
ATLASSIAN_EMAIL=

# ---------------------------------------------------------------- real CI waits, all optional
# Seconds to wait for a job to appear, to leave the queue (Azure, Bitbucket) and to end.
# Defaults per provider are in scripts/ci-provider-<provider>.sh.
CI_WAIT_APPEAR_SECONDS=
CI_WAIT_QUEUE_SECONDS=
CI_WAIT_JOB_SECONDS=

# ---------------------------------------------------------------- derived, set only to override
# Never needed in .env; export them for one run when the default does not fit:
#   ORG      default E2E_ORG
#   DEV      default <sfdx-hardis working copy>/bin/dev.js
#   EXT      default <sfdx-hardis working copy>/../vscode-sfdx-hardis
#   WORK     default <OS temp dir>/promo-e2e-<provider>      (real CI: promo-e2e-ci-<provider>)
#   LOGS     default <WORK>-logs
#   EXPECT   default <WORK>-expect
#   E2E_TMP  default ${TMPDIR:-${TEMP:-/tmp}}
#   REPO (GitHub), PROJECT_ID / PROJECT_PATH / GL_HOST / GL_TOKEN (GitLab), AZ_REPO_NAME (Azure),
#   BB_REPO (Bitbucket): the repository of the run, see the runbook section of each provider
