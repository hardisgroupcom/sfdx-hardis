{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Apex and Flow error trends, top failing automations and impacted users for one org.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [
    {
      "asDropdown": true,
      "icon": "external link",
      "includeVars": true,
      "keepTime": false,
      "tags": [
        "sfdx-hardis-v2"
      ],
      "targetBlank": false,
      "title": "Org Monitoring by sfdx-hardis",
      "type": "dashboards"
    }
  ],
  "panels": [
    {
      "id": 73,
      "type": "row",
      "title": "Error trends",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 56,
      "type": "timeseries",
      "title": "Errors per day with 7d average",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "gridPos": {
        "h": 9,
        "w": 16,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "expr": "max by (orgIdentifier) (last_over_time(ApexErrors_metric{source=\"sfdx-hardis\", orgIdentifier=\"$org\"}[1d]))",
          "refId": "A",
          "legendFormat": "Apex errors"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "expr": "max by (orgIdentifier) (last_over_time(FlowErrors_metric{source=\"sfdx-hardis\", orgIdentifier=\"$org\"}[1d]))",
          "refId": "B",
          "legendFormat": "Flow errors"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "expr": "max by (orgIdentifier) (avg_over_time(ApexErrors_metric{source=\"sfdx-hardis\", orgIdentifier=\"$org\"}[7d]))",
          "refId": "C",
          "legendFormat": "Apex 7d avg"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "expr": "max by (orgIdentifier) (avg_over_time(FlowErrors_metric{source=\"sfdx-hardis\", orgIdentifier=\"$org\"}[7d]))",
          "refId": "D",
          "legendFormat": "Flow 7d avg"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue"
              }
            ]
          },
          "links": [
            {
              "title": "Apex error details",
              "url": "/d/sfdx-hardis-v2-dtl-indicator/?var-org=$org&${ds_prom:queryparam}&${ds_loki:queryparam}&${__url_time_range}&var-type=APEX_ERROR"
            },
            {
              "title": "Flow error details",
              "url": "/d/sfdx-hardis-v2-dtl-indicator/?var-org=$org&${ds_prom:queryparam}&${ds_loki:queryparam}&${__url_time_range}&var-type=FLOW_ERROR"
            }
          ],
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "drawStyle": "line",
            "fillOpacity": 12,
            "gradientMode": "opacity",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": true,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 57,
      "type": "stat",
      "title": "Errors this week vs last week",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "expr": "((sum(sum_over_time(ApexErrors_metric{source=\"sfdx-hardis\", orgIdentifier=\"$org\"}[7d])) or vector(0)) + (sum(sum_over_time(FlowErrors_metric{source=\"sfdx-hardis\", orgIdentifier=\"$org\"}[7d])) or vector(0))) - ((sum(sum_over_time(ApexErrors_metric{source=\"sfdx-hardis\", orgIdentifier=\"$org\"}[7d] offset 7d)) or vector(0)) + (sum(sum_over_time(FlowErrors_metric{source=\"sfdx-hardis\", orgIdentifier=\"$org\"}[7d] offset 7d)) or vector(0)))",
          "refId": "A"
        }
      ],
      "description": "Positive = more errors than the previous 7 days.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 20
              }
            ]
          },
          "links": [
            {
              "title": "Apex error details",
              "url": "/d/sfdx-hardis-v2-dtl-indicator/?var-org=$org&${ds_prom:queryparam}&${ds_loki:queryparam}&${__url_time_range}&var-type=APEX_ERROR"
            },
            {
              "title": "Flow error details",
              "url": "/d/sfdx-hardis-v2-dtl-indicator/?var-org=$org&${ds_prom:queryparam}&${ds_loki:queryparam}&${__url_time_range}&var-type=FLOW_ERROR"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
