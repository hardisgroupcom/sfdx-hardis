{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Current org limit usage, 90-day trends and linear forecasts of limit exhaustion.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [
    {
      "asDropdown": true,
      "icon": "external link",
      "includeVars": true,
      "keepTime": false,
      "tags": [
        "sfdx-hardis-v2"
      ],
      "targetBlank": false,
      "title": "Org Monitoring by sfdx-hardis",
      "type": "dashboards"
    }
  ],
  "panels": [
    {
      "id": 85,
      "type": "row",
      "title": "Current usage",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 78,
      "type": "table",
      "title": "All limits",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "gridPos": {
        "h": 12,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "expr": "label_replace(max by (__name__) (last_over_time({__name__=~\".+_percent\", source=\"sfdx-hardis\", type=\"ORG_LIMITS\", orgIdentifier=\"$org\"}[2d])), \"limit\", \"$1\", \"__name__\", \"(.+)_percent\")",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "__proxy_source__": true,
              "Time": true,
              "__name__": true
            },
            "renameByName": {
              "limit": "Limit",
              "Value": "Used %"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              },
              {
                "color": "yellow",
                "value": 50
              },
              {
                "color": "orange",
                "value": 75
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "unit": "percent",
          "links": [
            {
              "title": "Open limit evolution",
              "url": "/d/sfdx-hardis-v2-dtl-indicator/?var-org=$org&var-type=ORG_LIMITS&var-metric=${__data.fields.Limit}_percent&${ds_prom:queryparam}&${ds_loki:queryparam}&${__url_time_range}"
            }
          ],
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true,
            "inspect": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Used %"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "gradient",
                  "valueDisplayMode": "text"
                }
              },
              {
                "id": "max",
                "value": 100
              },
              {
                "id": "min",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Used %",
            "desc": true
          }
        ]
      }
    },
    {
      "id": 79,
      "type": "table",
      "title": "Days until limit is reached (30d linear trend)",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "gridPos": {
        "h": 12,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "expr": "min by (orgIdentifier) (clamp_max((100 - last_over_time(DataStorageMB_percent{source=\"sfdx-hardis\", orgIdentifier=\"$org\"}[2d])) / clamp_min(deriv(DataStorageMB_percent{source=\"sfdx-hardis\", orgIdentifier=\"$org\"}[30d]) * 86400, 0.000001), 99999))",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "time_series",
          "legendFormat": "Data Storage"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "expr": "min by (orgIdentifier) (clamp_max((100 - last_over_time(FileStorageMB_percent{source=\"sfdx-hardis\", orgIdentifier=\"$org\"}[2d])) / clamp_min(deriv(FileStorageMB_percent{source=\"sfdx-hardis\", orgIdentifier=\"$org\"}[30d]) * 86400, 0.000001), 99999))",
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "time_series",
          "legendFormat": "File Storage"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "expr": "min by (orgIdentifier) (clamp_max((100 - last_over_time(DailyApiRequests_percent{source=\"sfdx-hardis\", orgIdentifier=\"$org\"}[2d])) / clamp_min(deriv(DailyApiRequests_percent{source=\"sfdx-hardis\", orgIdentifier=\"$org\"}[30d]) * 86400, 0.000001), 99999))",
          "refId": "C",
          "instant": true,
          "range": false,
          "format": "time_series",
          "legendFormat": "Daily API Requests"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "expr": "min by (orgIdentifier) (clamp_max((100 - last_over_time(DailyBulkApiBatches_percent{source=\"sfdx-hardis\", orgIdentifier=\"$org\"}[2d])) / clamp_min(deriv(DailyBulkApiBatches_percent{source=\"sfdx-hardis\", orgIdentifier=\"$org\"}[30d]) * 86400, 0.000001), 99999))",
          "refId": "D",
          "instant": true,
          "range": false,
          "format": "time_series",
          "legendFormat": "Daily Bulk API Batches"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "expr": "min by (orgIdentifier) (clamp_max((100 - last_over_time(DailyAsyncApexExecutions_percent{source=\"sfdx-hardis\", orgIdentifier=\"$org\"}[2d])) / clamp_min(deriv(DailyAsyncApexExecutions_percent{source=\"sfdx-hardis\", orgIdentifier=\"$org\"}[30d]) * 86400, 0.000001), 99999))",
          "refId": "E",
          "instant": true,
          "range": false,
          "format": "time_series",
          "legendFormat": "Daily Async Apex"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "expr": "min by (orgIdentifier) (clamp_max((100 - last_over_time(DailyDeliveredPlatformEvents_percent{source=\"sfdx-hardis\", orgIdentifier=\"$org\"}[2d])) / clamp_min(deriv(DailyDeliveredPlatformEvents_percent{source=\"sfdx-hardis\", orgIdentifier=\"$org\"}[30d]) * 86400, 0.000001), 99999))",
          "refId": "F",
          "instant": true,
          "range": false,
          "format": "time_series",
          "legendFormat": "Daily Platform Events"
        }
      ],
      "description": "Linear regression over the last 30 days. \"No growth\" means the limit is not trending toward exhaustion.",
      "transformations": [
        {
          "id": "reduce",
          "options": {
            "reducers": [
              "last"
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "Field": "Limit",
              "Last": "Days until full"
            },
            "excludeByName": {
              "__proxy_source__": true
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "range",
              "options": {
                "from": -1000000000000000,
                "to": 0,
                "result": {
                  "text": "Limit exceeded",
                  "color": "red",
                  "index": 0
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 3650,
                "to": 1000000000000000,
                "result": {
                  "text": "No growth",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red"
              },
              {
                "color": "orange",
                "value": 30
              },
              {
                "color": "yellow",
                "value": 90
              },
              {
                "color": "green",
                "value": 365
              }
            ]
          },
          "unit": "d",
          "decimals": 0,
          "links": [
            {
              "title": "Open indicator detail",
              "url": "/d/sfdx-hardis-v2-dtl-indicator/?var-org=$org&${ds_prom:queryparam}&${ds_loki:queryparam}&${__url_time_range}&var-type=ORG_LIMITS"
            }
          ],
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true,
            "inspect": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Days until full"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Days until full",
            "desc": false
          }
        ]
      }
    },
