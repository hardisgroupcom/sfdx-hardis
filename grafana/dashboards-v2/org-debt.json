      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "expr": "max by (orgIdentifier) (last_over_time(MetadatasNotUsed_metric{source=\"sfdx-hardis\", orgIdentifier=\"$org\"}[2d]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
